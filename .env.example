# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Gemini (https://aistudio.google.com/apikey). Needed to create new scenes; the demos work without it.
GEMINI_API_KEY=
# Optional backup keys, used when the one above runs out of quota
# GEMINI_API_KEY_2=

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox). Sandbox only: no real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: a sandbox webhook pointing at https://<your-host>/api/paypal/webhook, with the events
# "Checkout order approved" and "Payment capture completed". Needs a public URL (not localhost).
# PAYPAL_WEBHOOK_ID=

# Optional tuning (defaults shown)
# DATA_DIR=data                  # where credit balances and PayPal orders are kept
# FREE_CREDITS=3                 # credits a new visitor starts with
# FREE_STARTS_PER_IP=3           # new visitors per address per day who get them
# ASSISTANT_CALLS_PER_DAY=40     # free assistant (chat) requests per visitor per day
# REFUNDS_PER_DAY=5              # failed generations per visitor per day that get their credit back
# POOL_CLAIM_PER_DAY=2           # student-pool credits a visitor with none left may take per day
# DAILY_GEMINI_CALL_CAP=3000     # Gemini requests per day for the whole server
